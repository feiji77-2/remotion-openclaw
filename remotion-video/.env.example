# ============================================================
# remotion-video 管线 — 环境变量配置模板
# ============================================================
# 复制为 .env 并填入实际值
# cp .env.example .env
# ============================================================
# 完整配置参考：DEVELOPMENT_MANUAL.zh-CN.md 第四章
# ============================================================

# ─── LLM Provider（国产优先）────────────────────────────
# 自动探测优先级：MiniMax > DashScope > DeepSeek > Moonshot > Zhipu > OpenAI-compatible
# 国外 provider 需额外设置 WORKFLOW_ENABLE_FOREIGN_PROVIDERS=1

# MiniMax（推荐国产主力）
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_WORKFLOW_MODEL=MiniMax-M2.7
MINIMAX_WORKFLOW_TIMEOUT_MS=240000

# DashScope / 阿里百炼 Qwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_WORKFLOW_MODEL=qwen-plus
DASHSCOPE_WORKFLOW_TIMEOUT_MS=240000

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_WORKFLOW_MODEL=deepseek-chat
DEEPSEEK_WORKFLOW_TIMEOUT_MS=240000

# Moonshot / Kimi
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_WORKFLOW_MODEL=moonshot-v1-8k
MOONSHOT_WORKFLOW_TIMEOUT_MS=240000

# Zhipu / GLM / 智谱AI
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_WORKFLOW_MODEL=glm-4-flash
ZHIPU_WORKFLOW_TIMEOUT_MS=240000

# OpenAI-compatible（国内中转 / 第三方兼容接口）
# 仅 OPENAI_API_KEY + OPENAI_BASE_URL 同时存在时启用
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_WORKFLOW_MODEL=gpt-4o-mini
OPENAI_WORKFLOW_TIMEOUT_MS=45000

# 国外 provider（需 WORKFLOW_ENABLE_FOREIGN_PROVIDERS=1）
# WORKFLOW_ENABLE_FOREIGN_PROVIDERS=1
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_WORKFLOW_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_WORKFLOW_TIMEOUT_MS=240000
# GEMINI_API_KEY=...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_WORKFLOW_MODEL=gemini-2.0-flash
# GEMINI_WORKFLOW_TIMEOUT_MS=45000

# OpenClaw legacy（已废弃，仅 OPENCLAW_LEGACY_FALLBACK=1 时尝试）
# OPENCLAW_LEGACY_FALLBACK=1
# OPENCLAW_CLI_PATH=
# OPENCLAW_WORKFLOW_TRANSPORT=gateway
# OPENCLAW_WORKFLOW_MODEL=

# ─── TTS 语音 ────────────────────────────────────────────
# Qwen TTS（推荐，阿里云百炼）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_TTS_DEFAULT_VOICE=Cherry
QWEN_TTS_SYSTEM_MODEL=qwen3-tts-flash
QWEN_TTS_CLONE_MODEL=qwen3-tts-vc-2026-01-22
WORKFLOW_DEFAULT_VOICE_ENGINE=qwen-tts
WORKFLOW_DEFAULT_QWEN_LANGUAGE=zh-cn
WORKFLOW_DEFAULT_VOICE_SPEED=1.0

# ─── Deepgram 字幕（可选）───────────────────────────────
DEEPGRAM_API_KEY=

# ─── 队列模式 ────────────────────────────────────────────
PIPELINE_QUEUE_MODE=redis
PIPELINE_ALLOW_FILE_QUEUE=false

# ─── Redis（仅 queue=redis 时需要）─────────────────────
REDIS_URL=redis://localhost:6379

# ─── Worker 配置 ────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_DURATION_LIMIT=1200000

# ─── Remotion 渲染性能 ──────────────────────────────────
# 浏览器路径（默认自动探测）
# REMOTION_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 硬件加速（if-possible / disable / required）
# REMOTION_HARDWARE_ACCELERATION=if-possible
# 并发数（默认根据 CPU/内存自动计算）
# REMOTION_CONCURRENCY=4
# OpenGL 渲染器
# REMOTION_GL=angle
# 视觉模式：fast（长片默认）| cinematic（短片/封面）
# RENDER_VISUAL_MODE=fast
# CRF 质量（18=最高, 23=推荐, 28=快速）
# REMOTION_CRF=23

# ─── API Server ──────────────────────────────────────────
PORT=3001
PIPELINE_API_KEY=change-me
PIPELINE_ADMIN_KEY=change-me-admin
PIPELINE_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
PIPELINE_READ_RATE_LIMIT=240
PIPELINE_WRITE_RATE_LIMIT=30

# ─── Webhook（可选）─────────────────────────────────────
PIPELINE_WEBHOOK_HOSTS=

# ─── 远程媒体素材（默认关闭）──────────────────────────
PIPELINE_ALLOW_REMOTE_MEDIA=false

# ─── S3/MinIO 存储（可选，未来支持）───────────────────
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=openclaw-videos

# ─── TTS 并发控制 ──────────────────────────────────────
TTS_CONCURRENCY=6

# ─── LLM 缓存 TTL（小时）───────────────────────────────
LLM_CACHE_TTL_HOURS=24

# ─── 内存高压线（0.0-1.0）─────────────────────────────
PIPELINE_MEMORY_HIGH_WATER=0.85
