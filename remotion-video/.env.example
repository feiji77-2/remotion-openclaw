# ============================================================
# OpenClaw Video Pipeline — 环境变量配置
# ============================================================
# 复制为 .env 并填入实际值
# cp .env.example .env
# ============================================================

# ─── 队列模式（默认 redis，file 仅限本地开发）───────────────
# file: 仅限单机开发，且需要显式允许 PIPELINE_ALLOW_FILE_QUEUE=true
# redis: 使用 BullMQ + Redis，适合并发/服务化部署
PIPELINE_QUEUE_MODE=redis
PIPELINE_ALLOW_FILE_QUEUE=false

# ─── Redis（仅 PIPELINE_QUEUE_MODE=redis 时需要）────────────
# 任务队列存储（本地开发用 Docker 或 brew install redis）
REDIS_URL=redis://localhost:6379

# ─── Deepgram 字幕（可选，推荐）────────────────────────────
# 免费注册：https://console.deepgram.com/
# 免费额度：200分钟/月
DEEPGRAM_API_KEY=

# ─── OpenAI Whisper 字幕（可选，备选）────────────────────
# 替代 Deepgram，Whisper API $0.006/分钟
# 仅在显式切到 OpenAI / 兼容网关时，工作流生成会使用 OPENAI_WORKFLOW_MODEL
OPENAI_API_KEY=
OPENAI_WHISPER_API_KEY=
OPENAI_BASE_URL=
OPENAI_WORKFLOW_MODEL=gpt-4o-mini

# ─── Workflow / TTS（本地工作流编辑器）───────────────────
# Step 1-3 工作流生成默认走 OpenClaw infer
# 优先级：
# 1. 显式配置 OPENAI_API_KEY 时，按 OpenAI / 兼容网关配置走
# 2. 否则自动调用本机 OpenClaw CLI 的 infer 能力（默认 gateway transport）
# 3. 模型默认读取 ~/.openclaw/openclaw.json 的 agents.defaults.model.primary
OPENCLAW_CLI_PATH=
OPENCLAW_WORKFLOW_TRANSPORT=gateway
OPENCLAW_WORKFLOW_MODEL=
OPENCLAW_WORKFLOW_TIMEOUT_MS=240000
# 若要显式切回 OpenAI，可保留上面的 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_WORKFLOW_MODEL
# 语音步骤生成：默认走本机 ChatTTS HTTP 服务
CHATTTS_HTTP_HEALTH_URL=http://127.0.0.1:18084/health
CHATTTS_HTTP_SYNTH_URL=http://127.0.0.1:18084/synthesize

# 兼容旧链路：本机 Melo HTTP 服务
MELO_HTTP_HEALTH_URL=http://127.0.0.1:18081/health
MELO_HTTP_SYNTH_URL=http://127.0.0.1:18081/synthesize

# ─── Worker 配置 ─────────────────────────────────────────
# 同时渲染的任务数（内存够可以调大）
WORKER_CONCURRENCY=2
# 单个渲染任务超时（毫秒）
WORKER_DURATION_LIMIT=1200000

# ─── API Server ───────────────────────────────────────────
PORT=3001
PIPELINE_API_KEY=change-me
PIPELINE_ADMIN_KEY=change-me-admin
PIPELINE_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
PIPELINE_READ_RATE_LIMIT=240
PIPELINE_WRITE_RATE_LIMIT=30

# ─── Webhook 安全（可选）──────────────────────────────────
# 留空表示禁用 webhook 回调；如需开启，必须填写允许的 host 白名单
PIPELINE_WEBHOOK_HOSTS=

# ─── 远程媒体素材（默认关闭）──────────────────────────────
# 仅在你明确接受远程媒体抓取风险时再打开
PIPELINE_ALLOW_REMOTE_MEDIA=false

# ─── S3/MinIO 存储（可选，未来支持）───────────────────────
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=openclaw-videos
