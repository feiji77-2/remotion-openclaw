# ============================================================
# OpenClaw Video Pipeline — staging 示例配置
# ============================================================
# 使用方式：
# 1. cp .env.staging.example .env.staging
# 2. 按实际 staging 环境补齐下列值
# 3. 启动 API / Worker 后执行：
#    node scripts/run-staging-smoke.mjs
# ============================================================

NODE_ENV=production
PORT=3001
PIPELINE_API_BASE=http://127.0.0.1:3001

# 生产 / staging 必须启用 Redis
PIPELINE_QUEUE_MODE=redis
PIPELINE_ALLOW_FILE_QUEUE=false
REDIS_URL=redis://127.0.0.1:6379

# 普通 API 与管理 API 分离
PIPELINE_API_KEY=staging-api-key
PIPELINE_ADMIN_KEY=staging-admin-key

# 只允许 staging 前端域名
PIPELINE_ALLOWED_ORIGINS=https://staging.example.com

# 限流阈值，可按机器容量调整
PIPELINE_READ_RATE_LIMIT=240
PIPELINE_WRITE_RATE_LIMIT=30

# 若 staging 需要 webhook，显式放开回调 host
PIPELINE_WEBHOOK_HOSTS=

# 默认禁止远程媒体
PIPELINE_ALLOW_REMOTE_MEDIA=false

# 语音 / 工作流依赖
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_WORKFLOW_MODEL=gpt-4o-mini
OPENCLAW_CLI_PATH=
OPENCLAW_WORKFLOW_TRANSPORT=gateway
OPENCLAW_WORKFLOW_TIMEOUT_MS=240000
CHATTTS_HTTP_HEALTH_URL=http://127.0.0.1:18084/health
CHATTTS_HTTP_SYNTH_URL=http://127.0.0.1:18084/synthesize
MELO_HTTP_HEALTH_URL=http://127.0.0.1:18081/health
MELO_HTTP_SYNTH_URL=http://127.0.0.1:18081/synthesize
