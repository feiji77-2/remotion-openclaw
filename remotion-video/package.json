{
  "name": "remotion-generated-video",
  "version": "3.0.0",
  "description": "OpenClaw Remotion 运行时，包含 workflow API、配音、图片、项目构建与渲染链路",
  "scripts": {
    "dev": "remotion studio src/Root.tsx",
    "build": "remotion render src/Root.tsx OpenClawVideo out/openclaw-video.mp4",
    "preview": "remotion preview src/Root.tsx",
    "pipeline:start": "./scripts/start-pipeline.sh",
    "pipeline:api": "node server/api/server.js",
    "pipeline:worker": "node server/workers/renderWorker.js",
    "typecheck": "tsc --noEmit",
    "check:server": "node --check server/api/server.js && node --check server/workers/renderWorker.js && node --check server/workflow/skillRegistry.js && node --check server/workflow/step123/pipeline.js",
    "clean:runtime": "node scripts/clean-runtime.mjs"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.0.0",
    "@remotion/bundler": "4.0.445",
    "@remotion/cli": "4.0.445",
    "@remotion/media": "4.0.445",
    "@remotion/player": "4.0.445",
    "@remotion/renderer": "4.0.445",
    "bullmq": "^5.73.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "openai": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.445",
    "remotion-animated": "^2.2.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
