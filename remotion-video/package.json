{
  "name": "remotion-generated-video",
  "version": "3.0.0",
  "description": "OpenClaw Remotion 运行时，包含 workflow API、配音、图片、项目构建与渲染链路",
  "scripts": {
    "dev": "remotion studio src/Root.tsx",
    "build": "remotion render src/Root.tsx Video1v4 out/hermes_openclaw_v4.mp4",
    "preview": "remotion preview src/Root.tsx Video1v4",
    "ultimate:check": "node scripts/check-ultimate-scene.mjs --config examples/ultimate-scene-demo.json",
    "ultimate:render": "node scripts/render-ultimate-scene.mjs --config examples/ultimate-scene-demo.json --out out/ultimate-scene-demo.mp4",
    "ultimate:outline:check": "node scripts/check-ultimate-scene.mjs --outline examples/ultimate-outline-demo.json",
    "ultimate:outline:compile": "node scripts/compile-ultimate-outline.mjs --outline examples/ultimate-outline-demo.json --out out/ultimate-outline-demo.compiled.json --write-normalized out/ultimate-outline-demo.normalized.json",
    "ultimate:outline:render": "node scripts/render-ultimate-scene.mjs --outline examples/ultimate-outline-demo.json --out out/ultimate-outline-demo.mp4",
    "content:generate": "node scripts/generate-content-manifest.js",
    "project:build": "node scripts/build-project-package.mjs",
    "project:render": "node scripts/render-project.mjs",
    "workflow:ultimate": "node scripts/run-search-to-ultimate.mjs",
    "render:doctor": "node scripts/doctor-render-env.mjs",
    "pipeline:start": "./scripts/start-pipeline.sh",
    "pipeline:api": "node server/api/server.js",
    "pipeline:worker": "node server/workers/renderWorker.js",
    "voice:qwen": "node scripts/voice/qwen-tts-voice.mjs",
    "voice:cosyvoice": "node scripts/voice/cosyvoice-bailian-voice.mjs",
    "smoke:staging": "node scripts/run-staging-smoke.mjs",
    "test": "node --test server/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "check:server": "node --check server/api/server.js && node --check server/workers/renderWorker.js && node --check server/workflow/skillRegistry.js && node --check server/workflow/step123/pipeline.js",
    "clean:runtime": "node scripts/clean-runtime.mjs",
    "pipeline": "python3 pipeline.py",
    "pipeline:all": "python3 pipeline.py --step all",
    "pipeline:tts": "python3 pipeline.py --step tts",
    "pipeline:concat": "python3 pipeline.py --step concat",
    "pipeline:verify": "python3 pipeline.py --step verify",
    "pipeline:tsc": "python3 pipeline.py --step tsc",
    "pipeline:render": "python3 pipeline.py --step render",
    "pipeline:merge": "python3 pipeline.py --step merge",
    "pipeline:qa": "python3 pipeline.py --step qa",
    "pipeline:render-shard": "node scripts/render-with-cache.js",
    "pipeline:platform": "node scripts/render-for-platform.js"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.0.0",
    "@remotion/bundler": "4.0.448",
    "@remotion/cli": "4.0.448",
    "@remotion/media": "4.0.448",
    "@remotion/player": "4.0.448",
    "@remotion/renderer": "4.0.448",
    "bullmq": "^5.73.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "openai": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.448",
    "remotion-animated": "^2.2.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
