+#!/usr/bin/env node
+
+const fs = require('fs');
+const path = require('path');
+
+const PROJECT_DIR = path.resolve(__dirname, '..');
+const INPUT_JSON = path.join(PROJECT_DIR, 'audio-tmp', 'segments_meta_v4h.json');
+const OUTPUT_TS = path.join(PROJECT_DIR, 'src', 'data', 'segments_meta_v4h.ts');
+const TRANSITION_FRAMES = 20;
+const FPS = 30;
+
+// 说明：
+// timing/source 真源来自 harness 产出的 JSON。
+// 当前渲染链路仍然需要语义化 shotType，因此这里保留按镜头序号映射的 render shotType。
+const SHOT_TYPES = [
+  'opening',
+  'concept',
+  'comparison',
+  'bullets',
+  'concept',
+  'bullets',
+  'comparison',
+  'comparison',
+  'comparison',
+  'tech',
+  'tech',
+  'info',
+  'info',
+  'flowchart',
+  'flowchart',
+  'flowchart',
+  'case',
+  'case',
+  'concept',
+  'cta',
+];
+
+const normalizeId = (raw, index) => {
+  const matched = String(raw || '').match(/^shot-?(\d+)$/i);
+  const number = matched ? matched[1] : String(index + 1);
+  return `shot-${String(number).padStart(2, '0')}`;
+};
+
+const pad = (value, width) => String(value).padEnd(width, ' ');
+
+const main = () => {
+  if (!fs.existsSync(INPUT_JSON)) {
+    console.error(`[contract:sync] missing input: ${INPUT_JSON}`);
+    process.exit(1);
+  }
+
+  const raw = JSON.parse(fs.readFileSync(INPUT_JSON, 'utf8'));
+  if (!Array.isArray(raw) || raw.length === 0) {
+    console.error('[contract:sync] segments_meta_v4h.json is empty or invalid');
+    process.exit(1);
+  }
+
+  const segments = raw.map((segment, index) => ({
+    id: normalizeId(segment.id, index),
+    start: Number(segment.startFrame),
+    frames: Number(segment.duration_frames),
+    dur: Number(segment.duration_s),
+    shotType: SHOT_TYPES[index] || 'content',
+    text: String(segment.text || '').trim(),
+  }));
+
+  const last = segments[segments.length - 1];
+  const totalFrames = last.start + last.frames + TRANSITION_FRAMES;
+
+  const body = segments.map((segment) => {
+    return `  { id: '${segment.id}', start: ${pad(segment.start, 5)}, frames: ${pad(segment.frames, 3)}, dur: ${segment.dur.toFixed(3)}, shotType: '${segment.shotType}', text: ${JSON.stringify(segment.text)} },`;
+  }).join('\n');
+
+  const output = `/**
+ * segments_meta_v4h.ts — WhisperX 实测版渲染合同
+ *
+ * ⚠️ 此文件由 sync-render-contract.js 自动生成，禁止手动修改
+ * 源: audio-tmp/segments_meta_v4h.json
+ * 用途: Video1v4.tsx 的 SEGMENTS 和 Root.tsx 的 durationInFrames
+ */
+
+import type { SegmentMeta } from '../types';
+
+export const TRANSITION_FRAMES = ${TRANSITION_FRAMES};
+export const FPS = ${FPS};
+
+export const SEGMENTS: SegmentMeta[] = [
+${body}
+];
+
+export const TOTAL_FRAMES = ${totalFrames};
+`;
+
+  fs.writeFileSync(OUTPUT_TS, output);
+  console.log(`[contract:sync] wrote ${path.relative(PROJECT_DIR, OUTPUT_TS)} (${segments.length} shots, ${totalFrames} frames)`);
+};
+
+main();

