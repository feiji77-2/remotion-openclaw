+++ b/scripts/load-render-contract.js
@@
+const fs = require('fs');
+const path = require('path');
+
+const PROJECT_DIR = path.resolve(__dirname, '..');
+const JSON_PATH = path.join(PROJECT_DIR, 'audio-tmp', 'segments_meta_v4h.json');
+const TS_PATH = path.join(PROJECT_DIR, 'src', 'data', 'segments_meta_v4h.ts');
+const TRANSITION_FRAMES = 20;
+
+const normalizeId = (raw, index) => {
+  const matched = String(raw || '').match(/^shot-?(\d+)$/i);
+  const number = matched ? matched[1] : String(index + 1);
+  return `shot-${String(number).padStart(2, '0')}`;
+};
+
+const loadFromJson = () => {
+  const raw = JSON.parse(fs.readFileSync(JSON_PATH, 'utf8'));
+  if (!Array.isArray(raw) || raw.length === 0) {
+    throw new Error('segments_meta_v4h.json is empty or invalid');
+  }
+
+  const segments = raw.map((segment, index) => ({
+    id: normalizeId(segment.id, index),
+    start: Number(segment.startFrame),
+    frames: Number(segment.duration_frames),
+    text: String(segment.text || '').trim(),
+  }));
+
+  const last = segments[segments.length - 1];
+  return {
+    source: JSON_PATH,
+    transitionFrames: TRANSITION_FRAMES,
+    totalFrames: last.start + last.frames + TRANSITION_FRAMES,
+    segments,
+  };
+};
+
+const loadFromTsFallback = () => {
+  const content = fs.readFileSync(TS_PATH, 'utf8');
+  const segments = [];
+  const totalMatch = content.match(/TOTAL_FRAMES\\s*=\\s*(\\d+)/);
+
+  for (const line of content.split('\n')) {
+    const matched = line.match(/\\{ id:\\s*['"](\\S+)['"],\\s*start:\\s*(\\d+),\\s*frames:\\s*(\\d+)/);
+    if (matched) {
+      segments.push({
+        id: matched[1],
+        start: Number(matched[2]),
+        frames: Number(matched[3]),
+        text: '',
+      });
+    }
+  }
+
+  if (segments.length === 0) {
+    throw new Error('segments_meta_v4h.ts is empty or invalid');
+  }
+
+  const last = segments[segments.length - 1];
+  return {
+    source: TS_PATH,
+    transitionFrames: TRANSITION_FRAMES,
+    totalFrames: totalMatch ? Number(totalMatch[1]) : last.start + last.frames + TRANSITION_FRAMES,
+    segments,
+  };
+};
+
+const loadRenderContract = () => {
+  if (fs.existsSync(JSON_PATH)) {
+    return loadFromJson();
+  }
+
+  if (fs.existsSync(TS_PATH)) {
+    return loadFromTsFallback();
+  }
+
+  throw new Error('No render contract found');
+};
+
+module.exports = {
+  PROJECT_DIR,
+  TRANSITION_FRAMES,
+  loadRenderContract,
+};

