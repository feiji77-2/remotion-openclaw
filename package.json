{
  "name": "codex-remotion-project",
  "private": true,
  "version": "2.0.0",
  "description": "Codex-first Remotion renderer driven by one Project JSON contract",
  "license": "MIT",
  "keywords": [
    "remotion",
    "react",
    "typescript",
    "video-generation"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "npm --prefix remotion-video install",
    "clean": "npm --prefix remotion-video run clean:runtime && node -e \"require('node:fs').rmSync('remotion-video/out',{recursive:true,force:true})\"",
    "dev": "npm --prefix remotion-video run dev",
    "project:check": "npm --prefix remotion-video run project:check --",
    "project:still": "npm --prefix remotion-video run project:still --",
    "project:render": "npm --prefix remotion-video run project:render --",
    "project:import": "npm --prefix remotion-video run project:import --",
    "test": "npm --prefix remotion-video run test",
    "typecheck": "npm --prefix remotion-video run typecheck",
    "build": "npm --prefix remotion-video run build",
    "release:check": "npm run test && npm run typecheck && npm run project:check -- examples/project.json && npm --prefix remotion-video run release:render && npm --prefix remotion-video run release:verify"
  }
}
